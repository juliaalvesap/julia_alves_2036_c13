%% Questão 5
clc;
clear all;
close all;

%% Equipamento A - Sistema de primeira ordem

G_A = tf(2, [1.2 1]);

pole(G_A)
dcgain(G_A)

% Tempo de subida (10% a 90%)
tempo_subida_A = 2.2*1.2

% Tempo de acomodacao (2%)
tempo_acomodacao_A = 4*1.2

% Valor final = 2

%% Equipamento B - Sistema de segunda ordem

G_B = tf(32, [1 5.6 16]);

[wn_B, zeta_B, polos_B] = damp(G_B);

wn_B(1)
zeta_B(1)
polos_B
dcgain(G_B)

% Frequencia natural = 4 rad/s
% Coeficiente de amortecimento = 0.7

% Tempo de subida (10% a 90%)
tempo_subida_B = 0.761

% Tempo de acomodacao (2%)
tempo_acomodacao_B = 4/(zeta_B(1)*wn_B(1))

% Tempo de pico
tempo_pico_B = pi/(wn_B(1)*sqrt(1-zeta_B(1)^2))

% Maximo sobressinal = 4.60%
sobressinal_B = exp((-zeta_B(1)*pi)/sqrt(1-zeta_B(1)^2))*100

% Valor do primeiro pico
primeiro_pico_B = 2*(1 + sobressinal_B/100)

% Valor final = 2

%% Resposta ao degrau unitario

t = 0:0.01:8;

figure
step(G_A, G_B, t), grid

title("Resposta ao degrau unitario")
legend("Equipamento A", "Equipamento B")
xlabel("Tempo (s)")
ylabel("Amplitude")

%% Entrada de amplitude 1.5

