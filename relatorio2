%% questão 2

clc;
clear all;
close all;

R = 2000;
tau = 2.5;

C = tau/R;

disp("Valor da capacitancia:")
disp(C)

num = 1;
den = [R*C 1];

G1 = tf(num, den);

disp("funcao de transferencia:")
G1

figure
step(G1, 15)

grid on

xlabel("tempo (s)")
ylabel("tensao de saida (V)")
title("circuito RC - caixa cinza")

Rteste = 100:100:10000;

tauTeste = Rteste*C;

figure

% escala comum
subplot(2,2,1)
plot(Rteste,tauTeste)
grid on
xlabel("resistencia (ohm)")
ylabel("const de tempo (s)")
title("escala comum")

% escala log vertical
subplot(2,2,2)
semilogy(Rteste,tauTeste)
grid on
xlabel("resistencia (ohm)")
ylabel("const de tempo (s)")
title("escala log eixo Y")

% escala log horizontal
subplot(2,2,3)
semilogx(Rteste,tauTeste)
grid on
xlabel("resistencia (ohm)")
ylabel("const de tempo (s)")
title("escala log eixo X")

% escala log ambos
subplot(2,2,4)
loglog(Rteste,tauTeste)
grid on
xlabel("resistencia (ohm)")
ylabel("const de tempo (s)")
title("escala log nos dois eixos")

